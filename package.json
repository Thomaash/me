{
  "name": "me",
  "version": "0.0.0-no-version",
  "private": true,
  "license": "ISC",
  "scripts": {
    "build": "vite build",
    "build:old-deploy-files": "./bin/build-old-deploy-files.sh",
    "clean": "rm -rf dist/*",
    "deploy": "./gh-pages.sh",
    "dev": "vite",
    "lint:ci": "eslint --ext .js,.vue .",
    "lint:fix": "eslint --ext .js,.vue --fix .",
    "postinstall": "patch-package",
    "preview": "vite preview --port 5173",
    "test": "npm run test:deps && npm run test:unit && npm run test:e2e",
    "test:deps": "depcruise --config .dependency-cruiser.js src",
    "test:e2e": "start-server-and-test preview http://127.0.0.1:5173/me/ test:e2e:cypress:run",
    "test:e2e:cypress:open": "cypress open",
    "test:e2e:cypress:run": "cypress run",
    "test:e2e:open": "start-server-and-test dev http://127.0.0.1:5173/me/ test:e2e:cypress:open",
    "test:unit": "cypress run --component",
    "test:unit:open": "cypress open --component",
    "visualize-deps": "depcruise src --include-only \"^src\" --config --output-type dot | dot -T svg > dependency-graph.svg"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@vueuse/core": "13.1.0",
    "antlr4": "4.9.3",
    "jspdf": "2.5.2",
    "jspdf-autotable": "3.8.4",
    "source-code-pro": "2.38.0",
    "source-sans-pro": "3.6.0",
    "uuid": "9.0.1",
    "vis-data": "7.1.9",
    "vis-network": "9.1.9",
    "vis-util": "5.0.7",
    "vue": "3.5.13",
    "vue-router": "4.5.1",
    "vuetify": "3.8.2",
    "vuex": "4.1.0",
    "vuex-ltm": "1.1.9",
    "vuex-shared-mutations": "1.0.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.27.0",
    "@types/uuid": "10.0.0",
    "@vitejs/plugin-vue": "5.2.3",
    "@vue/babel-preset-app": "5.0.8",
    "@vue/eslint-config-prettier": "9.0.0",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "10.4.21",
    "chai": "5.2.0",
    "cypress": "13.17.0",
    "dependency-cruiser": "16.10.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-cypress": "2.15.2",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.2.6",
    "eslint-plugin-promise": "6.6.0",
    "eslint-plugin-vue": "9.33.0",
    "gh-pages": "6.3.0",
    "globby": "14.1.0",
    "jsdom": "25.0.1",
    "jsdom-global": "3.0.2",
    "keycharm": "0.4.0",
    "localforage": "1.10.0",
    "material-design-icons-iconfont": "6.7.0",
    "mocha": "10.8.2",
    "patch-package": "8.0.0",
    "sass": "1.87.0",
    "start-server-and-test": "2.0.11",
    "vite": "6.3.3",
    "vite-plugin-vuetify": "2.1.1",
    "vue-template-compiler": "2.7.16"
  },
  "volta": {
    "node": "20.19.1",
    "npm": "10.9.2"
  }
}
