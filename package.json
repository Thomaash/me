{
  "name": "me",
  "version": "0.0.0-no-version",
  "type": "module",
  "private": true,
  "license": "ISC",
  "scripts": {
    "build": "vite build",
    "build:old-deploy-files": "./bin/build-old-deploy-files.sh",
    "clean": "rm -rf dist/*",
    "deploy": "./gh-pages.sh",
    "deps:ci": "depcruise src",
    "deps:visualize": "depcruise src --include-only \"^src\" --config --output-type dot | dot -T svg > dependency-graph.svg",
    "dev": "vite",
    "lint:ci": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "preview": "vite preview --port 5173",
    "style:ci": "prettier .",
    "style:fix": "prettier --write .",
    "test": "npm run test:vitest:unit && npm run test:vitest:browser && npm run test:e2e",
    "test:e2e": "start-server-and-test preview http://127.0.0.1:5173/me/ test:e2e:playwright:run",
    "test:e2e:open": "start-server-and-test dev http://127.0.0.1:5173/me/ test:e2e:playwright:open",
    "test:e2e:playwright:open": "playwright test --ui",
    "test:e2e:playwright:run": "playwright test",
    "test:mutate": "stryker run",
    "test:vitest:browser": "vitest run --config vitest.config.browser.js",
    "test:vitest:browser:coverage": "vitest run --config vitest.config.browser.js --coverage",
    "test:vitest:unit": "vitest run --config vitest.config.unit.js",
    "test:vitest:unit:coverage": "vitest run --config vitest.config.unit.js --coverage"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@vueuse/core": "14.2.1",
    "antlr4": "4.13.2",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.7",
    "source-code-pro": "2.42.0",
    "source-sans": "3.52.0",
    "uuid": "13.0.0",
    "vis-data": "8.0.3",
    "vis-network": "10.0.2",
    "vis-util": "6.0.0",
    "vue": "3.5.32",
    "vue-router": "5.0.4",
    "vuetify": "^4.0.4",
    "vuex": "4.1.0",
    "vuex-ltm": "1.1.15",
    "vuex-shared-mutations": "1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@vitejs/plugin-vue": "6.0.5",
    "@vitest/browser": "^4.1.0",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/compiler-dom": "^3.5.31",
    "@vue/server-renderer": "^3.5.31",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "10.4.27",
    "dependency-cruiser": "17.3.10",
    "gh-pages": "6.3.0",
    "globals": "17.4.0",
    "globby": "16.2.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "oxlint": "1.58.0",
    "playwright": "^1.58.2",
    "prettier": "3.8.1",
    "start-server-and-test": "3.0.0",
    "vite": "7.3.2",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.16"
  },
  "volta": {
    "node": "24.14.1",
    "npm": "11.12.1"
  }
}
