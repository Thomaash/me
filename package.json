{
  "name": "me",
  "version": "0.0.0-no-version",
  "type": "module",
  "private": true,
  "license": "ISC",
  "scripts": {
    "build": "vite build",
    "build:old-deploy-files": "./bin/build-old-deploy-files.sh",
    "clean": "rm -rf dist/*",
    "deploy": "./gh-pages.sh",
    "deps:ci": "depcruise src",
    "deps:visualize": "depcruise src --include-only \"^src\" --config --output-type dot | dot -T svg > dependency-graph.svg",
    "dev": "vite",
    "lint:ci": "eslint --ext .js,.vue .",
    "lint:fix": "eslint --ext .js,.vue --fix .",
    "postinstall": "patch-package",
    "preview": "vite preview --port 5173",
    "style:ci": "prettier .",
    "style:fix": "prettier --write .",
    "test": "npm run test:deps && npm run test:unit && npm run test:e2e",
    "test:deps": "depcruise --config .dependency-cruiser.js src",
    "test:e2e": "start-server-and-test preview http://127.0.0.1:5173/me/ test:e2e:cypress:run",
    "test:e2e:cypress:open": "cypress open",
    "test:e2e:cypress:run": "cypress run",
    "test:e2e:open": "start-server-and-test dev http://127.0.0.1:5173/me/ test:e2e:cypress:open",
    "test:unit": "cypress run --component",
    "test:unit:open": "cypress open --component"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@vueuse/core": "13.1.0",
    "antlr4": "4.9.3",
    "jspdf": "3.0.1",
    "jspdf-autotable": "5.0.2",
    "source-code-pro": "2.38.0",
    "source-sans-pro": "3.6.0",
    "uuid": "9.0.1",
    "vis-data": "7.1.9",
    "vis-network": "9.1.9",
    "vis-util": "5.0.7",
    "vue": "3.5.13",
    "vue-router": "4.5.1",
    "vuetify": "3.8.4",
    "vuex": "4.1.0",
    "vuex-ltm": "1.1.11",
    "vuex-shared-mutations": "1.0.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.27.1",
    "@types/uuid": "10.0.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/babel-preset-app": "5.0.8",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "10.4.21",
    "chai": "5.2.0",
    "cypress": "14.3.3",
    "dependency-cruiser": "16.10.2",
    "eslint": "9.26.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-cypress": "4.3.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-n": "17.18.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-vue": "10.1.0",
    "gh-pages": "6.3.0",
    "globby": "14.1.0",
    "jsdom": "26.1.0",
    "jsdom-global": "3.0.2",
    "keycharm": "0.4.0",
    "localforage": "1.10.0",
    "material-design-icons-iconfont": "6.7.0",
    "mocha": "11.2.2",
    "patch-package": "8.0.0",
    "prettier": "3.5.3",
    "sass": "1.87.0",
    "start-server-and-test": "2.0.11",
    "vite": "6.3.5",
    "vite-plugin-vuetify": "2.1.1",
    "vue-template-compiler": "2.7.16"
  },
  "volta": {
    "node": "22.15.0",
    "npm": "11.3.0"
  }
}
