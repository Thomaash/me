{
  "name": "me",
  "version": "0.0.0-no-version",
  "type": "module",
  "private": true,
  "license": "ISC",
  "scripts": {
    "build": "vite build",
    "build:old-deploy-files": "./bin/build-old-deploy-files.sh",
    "clean": "rm -rf dist/*",
    "deploy": "./gh-pages.sh",
    "deps:ci": "depcruise src",
    "deps:visualize": "depcruise src --include-only \"^src\" --config --output-type dot | dot -T svg > dependency-graph.svg",
    "dev": "vite",
    "lint:ci": "eslint --ext .js,.vue .",
    "lint:fix": "eslint --ext .js,.vue --fix .",
    "postinstall": "patch-package",
    "preview": "vite preview --port 5173",
    "style:ci": "prettier .",
    "style:fix": "prettier --write .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "start-server-and-test preview http://127.0.0.1:5173/me/ test:e2e:cypress:run",
    "test:e2e:cypress:open": "cypress open",
    "test:e2e:cypress:run": "cypress run",
    "test:e2e:open": "start-server-and-test dev http://127.0.0.1:5173/me/ test:e2e:cypress:open",
    "test:unit": "cypress run --component",
    "test:unit:open": "cypress open --component"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@vueuse/core": "13.9.0",
    "antlr4": "4.13.2",
    "jspdf": "3.0.2",
    "jspdf-autotable": "5.0.2",
    "source-code-pro": "2.38.0",
    "source-sans-pro": "3.6.0",
    "uuid": "12.0.0",
    "vis-data": "8.0.1",
    "vis-network": "10.0.1",
    "vis-util": "6.0.0",
    "vue": "3.5.21",
    "vue-router": "4.5.1",
    "vuetify": "3.9.7",
    "vuex": "4.1.0",
    "vuex-ltm": "1.1.14",
    "vuex-shared-mutations": "1.0.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.28.4",
    "@eslint/compat": "1.3.2",
    "@eslint/js": "9.35.0",
    "@types/uuid": "10.0.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/babel-preset-app": "5.0.9",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "10.4.21",
    "cypress": "15.1.0",
    "dependency-cruiser": "17.0.1",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-exports": "1.0.0-beta.5",
    "eslint-import-resolver-vite": "2.1.0",
    "eslint-plugin-cypress": "5.1.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.21.3",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-vue": "10.4.0",
    "gh-pages": "6.3.0",
    "globals": "16.3.0",
    "globby": "14.1.0",
    "patch-package": "8.0.0",
    "prettier": "3.6.2",
    "start-server-and-test": "2.1.0",
    "vite": "7.1.5",
    "vite-plugin-vuetify": "2.1.2"
  },
  "engines": {
    "node": ">=21.2.0"
  },
  "volta": {
    "node": "22.19.0",
    "npm": "11.6.0"
  }
}
