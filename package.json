{
  "name": "me",
  "version": "0.0.0-no-version",
  "type": "module",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@11.0.4",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist/* .stryker-tmp",
    "deploy-echoes": "deploy-echoes https://www.vycital.eu/me/old-files/ --dist ./dist/me --archive-dir old-files --decompression-fallback none",
    "deps:ci": "depcruise src",
    "deps:visualize": "depcruise src --include-only \"^src\" --config --output-type dot | dot -T svg > dependency-graph.svg",
    "dev": "vite",
    "lint:ci": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "preview": "vite preview --port 5173",
    "style:ci": "prettier --check .",
    "style:fix": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "start-server-and-test preview http://127.0.0.1:5173/me/ test:e2e:playwright:run",
    "test:e2e:open": "start-server-and-test dev http://127.0.0.1:5173/me/ test:e2e:playwright:open",
    "test:e2e:playwright:open": "playwright test --ui",
    "test:e2e:playwright:run": "playwright test",
    "test:mutate": "stryker run",
    "test:vitest": "vitest run",
    "test:vitest:browser": "vitest run --project=browser",
    "test:vitest:browser:coverage": "vitest run --project=browser --coverage --coverage.reportsDirectory=reports/coverage/browser",
    "test:vitest:coverage": "vitest run --coverage",
    "test:vitest:unit": "vitest run --project=unit",
    "test:vitest:unit:coverage": "vitest run --project=unit --coverage --coverage.reportsDirectory=reports/coverage/unit"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@vueuse/core": "14.3.0",
    "antlr4": "4.13.2",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.7",
    "localforage": "1.10.0",
    "pinia": "3.0.4",
    "source-code-pro": "2.42.0",
    "source-sans": "3.52.0",
    "uuid": "14.0.0",
    "vis-data": "8.0.4",
    "vis-network": "10.0.3",
    "vis-util": "6.0.0",
    "vue": "3.5.34",
    "vue-router": "5.0.6",
    "vuetify": "4.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@playwright/test": "1.59.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tomina/deploy-echoes": "1.0.0",
    "@vitejs/plugin-vue": "6.0.6",
    "@vitest/browser": "4.1.5",
    "@vitest/browser-playwright": "4.1.5",
    "@vitest/coverage-v8": "4.1.5",
    "@vue/compiler-dom": "3.5.34",
    "@vue/server-renderer": "3.5.34",
    "@vue/test-utils": "2.4.10",
    "autoprefixer": "10.5.0",
    "dependency-cruiser": "17.4.0",
    "gh-pages": "6.3.0",
    "globals": "17.6.0",
    "globby": "16.2.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.2",
    "oxlint": "1.63.0",
    "playwright": "1.59.1",
    "prettier": "3.8.3",
    "start-server-and-test": "3.0.2",
    "vite": "8.0.16",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=22.16"
  }
}
