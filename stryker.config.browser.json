{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.browser.js"
  },
  "mutate": ["src/**/*.vue", "src/**/*.js", "!src/**/*.test.js", "!src/**/*.browser-test.js"],
  "reporters": ["clear-text", "html", "progress"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "tempDirName": ".stryker-tmp"
}
